# ==========================================
# HackForge SaaS Production Environment Config
# ==========================================

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://postgres.production.internal:5432/hackforge_prod
DB_USERNAME=hackforge_user
DB_PASSWORD=change_this_super_secure_password_in_production

# JWT Authentication
JWT_SECRET=change_this_to_at_least_64_character_random_hex_string_for_access_tokens
JWT_REFRESH_SECRET=change_this_to_at_least_64_character_random_hex_string_for_refresh_tokens
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis Cache & Queue
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_SSL=false

# RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq.production.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hackforge_mq
RABBITMQ_PASSWORD=change_this_rabbitmq_password
RABBITMQ_SSL=false

# AWS S3 Storage
AWS_S3_BUCKET=hackforge-production-uploads
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_PATH_STYLE=false

# SMTP Mail Server
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CORS Security
CORS_ALLOWED_ORIGINS=https://hackforge.io,https://app.hackforge.io

# Observability
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/1234567

# OAuth2 Integration
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
